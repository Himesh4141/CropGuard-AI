APP_NAME=CropGuard API
ENVIRONMENT=development

SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=cropguard_refresh
COOKIE_SECURE=false

DATABASE_URL=mysql+pymysql://cropguard_user:cropguard123@127.0.0.1:3306/cropguard?charset=utf8mb4
CORS_ORIGINS=["http://localhost:4141"]

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

ML_MODEL_PATH=ml/artifacts/tomato_disease_model.onnx
ML_METADATA_PATH=ml/artifacts/model_metadata.json
ML_MIN_CONFIDENCE=0.55

WEATHER_PROVIDER=open_meteo
WEATHER_TIMEOUT_SECONDS=8
WEATHER_FORECAST_DAYS=5
WEATHER_CACHE_MINUTES=15
